# Copy to infra/.env (not committed). Used by: docker compose --env-file .env up --build

DATABASE_USER=issue
DATABASE_PASSWORD=issue
DATABASE_NAME=issue_tracking

# Solo usado con docker-compose.host-postgres.yml
# POSTGRES_PORT=15432

# Host port → Nest (contenedor sigue escuchando en 3000). 3001 por defecto evita choque con otros servicios en :3000.
API_PORT=3001
WEB_PORT=8080

# Comma-separated browser origins allowed to call the API directly (e.g. ng serve on :4200).
# Docker UI uses nginx /api proxy; these still help if you expose the API port alone.
CORS_ORIGIN=http://localhost:4200,http://localhost:8080

# Never true in production — only for local schema experiments without migrations.
TYPEORM_SYNC=false
DATABASE_LOGGING=false
SEED_ON_BOOT=true

# PHP bridge (GoDaddy) usado por POST /incident-images/upload
# Ejemplo: https://proserla.com/proserla.com/issues-tracking/upload.php
GODADDY_PHP_UPLOAD_URL=
GODADDY_UPLOAD_SECRET=
