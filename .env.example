# Copy to `.env` at repo root (never commit `.env`).
# Used by scripts/deploy-godaddy-php.ps1 and documented for GitHub Actions secrets.

# --- GoDaddy FTP (deploy PHP bridge) ---
GODADDY_FTP_HOST=ftp.yourdomain.com
GODADDY_FTP_USER=your_ftp_username
GODADDY_FTP_PASSWORD=your_ftp_password
# Remote folder that mirrors `godaddy-php/` (trailing slash). Example: /public_html/incidencias-uploads/
GODADDY_FTP_REMOTE_PATH=/public_html/incidencias-uploads/
# true = explicit FTPS (typical GoDaddy port 21)
GODADDY_FTP_USE_TLS=true

# Public base URL of the `uploads/` directory (trailing slash). Example:
# https://yourdomain.com/incidencias-uploads/uploads/
GODADDY_PHP_PUBLIC_BASE_URL=https://yourdomain.com/incidencias-uploads/uploads/

# Same secret the PHP bridge expects (header X-Upload-Token). NestJS should use the same value server-side.
GODADDY_UPLOAD_SECRET=replace_with_long_random_string

# --- NestJS (when apps/back exists) ---
# GODADDY_PHP_UPLOAD_URL=https://yourdomain.com/incidencias-uploads/upload.php

# --- Docker (Postgres + API + Web): use separate file ---
# Copy infra/.env.example → infra/.env — see infra/README.md
