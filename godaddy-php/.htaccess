# Block direct HTTP access to config (PHP include from upload.php still works).
<Files "config.php">
    Require all denied
</Files>

# Optional: force HTTPS (uncomment on GoDaddy when SSL is active)
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Limit body size (adjust; must be >= PHP upload limits in cPanel)
<IfModule mod_php.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 10M
</IfModule>
