PORT=3000
CORS_ORIGIN=http://localhost:4200
NODE_ENV=development

# Prefer this in Railway (set by Railway Postgres or manually).
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=issue
DATABASE_PASSWORD=issue
DATABASE_NAME=issue_tracking
DATABASE_SSL=false
DATABASE_LOGGING=false

# Never true in production — only for local bootstrap without migrations.
TYPEORM_SYNC=false
SEED_ON_BOOT=false
